<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OC.Assistant.Twincat.ViewModels"
             x:Class="OC.Assistant.Twincat.Views.TaskSettings"
             x:DataType="vm:TaskSettingsViewModel"
             Margin="5,20">
    <StackPanel>
        <Label Margin="4,0,0,0" Content="Task name"/>
        <TextBox 
            Text="{Binding TaskName}"
            HorizontalAlignment="Stretch"
            Margin="0,5,0,10"/>
        <Label Margin="4,0,0,0" Content="Variables filter"/>
        <TextBox
            Text="{Binding Filter}"
            HorizontalAlignment="Stretch"
            Margin="0,5,0,10"
            ToolTip.Tip="{Binding ToolTip}"/>
    </StackPanel>
</UserControl>
